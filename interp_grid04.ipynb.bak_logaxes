    "\n",
    "from IPython.display import FileLink\n",
    "import gc\n",
    "from scipy.interpolate import RectBivariateSpline\n",
    "gc.collect()\n",
    "theta_E_4 = np.array([np.sqrt(4 * G * .4*(2e33) / c**2 * D_ls / (D_s * D_l))])\n",
    "theta_E_8 = np.array([np.sqrt(4 * G * .8*(2e33) / c**2 * D_ls / (D_s * D_l))])\n",
