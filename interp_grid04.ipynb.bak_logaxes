   "source": [
    "n = int(np.sqrt(len(x_rot)))\n",
    "\n",
    "x_grid = np.unique(positions_rot[:, 0].round(decimals=15))#*theta_step * image_size\n",
    "x_grid = np.concat((x_grid, (-x_grid[len(x_grid)-2::-1])))\n",
    "y_grid = np.unique(positions_rot[:, 1].round(decimals=15))#*theta_step * image_size\n",
    "y_grid = np.concat((-y_grid[::-1], (y_grid[1:])))\n",
    "\n",
    "rad_grid  = rad_04_combo.reshape(n, n)\n",
    "mass_grid = mass_04_combo.reshape(n, n)\n",
    "xpos_grid = posx_04_combo.reshape(n, n)\n",
    "ypos_grid = posy_04_combo.reshape(n, n)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "e62ce9ba-95d8-4c94-9b78-7fd5e40e3599",
   "metadata": {},
   "outputs": [],
   "source": [
    "rad_grid  = one_quad_to_full(rad_04_combo, n)\n",
    "mass_grid = one_quad_to_full(mass_04_combo, n)\n",
    "xpos_grid = one_quad_to_full(posx_04_combo, n)\n",
    "ypos_grid = one_quad_to_full(posy_04_combo, n)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "3552f60e-177c-4484-a42b-6f89ba0c534a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build interpolators\n",
    "rad_spline  = RegularGridInterpolator([x_grid, y_grid], rad_grid, method='linear')\n",
    "mass_spline = RegularGridInterpolator([x_grid, y_grid], mass_grid, method='linear')\n",
    "xpos_spline = RegularGridInterpolator([x_grid, y_grid], xpos_grid, method='linear') #takes position in radians, returns in mas\n",
    "ypos_spline = RegularGridInterpolator([x_grid, y_grid], ypos_grid, method='linear')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "8ea70a8d-e57c-4045-9e75-256d23ad0230",
   "metadata": {},
   "outputs": [],
   "source": [
    "fine_grid_x=np.linspace(np.min(x_grid), np.max(x_grid), 200)\n",
    "fine_grid_y=np.linspace(np.min(y_grid), np.max(y_grid), 200)\n",
    "X_fine, Y_fine = np.meshgrid(fine_grid_x, fine_grid_y, indexing='ij')\n",
    "#mass_interp = mass_spline.ev(X_fine.ravel(), Y_fine.ravel()).reshape(Y_fine.shape)"
   ]
  },
  {
   "cell_type": "code",
