    "    theta_x, theta_y = traj[\"positions_rad\"].T\n",
    "\n",
    "    # Plot trajectory\n",
    "    ls = '-'\n",
    "    ax.plot(theta_x, theta_y, ls, color='C0', marker='.', linewidth=1.5)\n",
