    "mag_fit=6.86\n",
    "phi_0=-2.07858699980682\n",
    "B_matrix=data['inv_jacobian_fit'][0]\n",
    "from scipy.interpolate import RegularGridInterpolator\n",
    "from scipy.stats import linregress\n"
   ]
